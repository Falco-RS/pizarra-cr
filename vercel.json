{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/data/alineaciones.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=20, stale-while-revalidate=20"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/de/:origen",
      "destination": "/index.html"
    }
  ]
}
